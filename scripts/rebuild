#!/usr/bin/env bash
set -euo pipefail

# Dependencies and build tools are installed by the image. Only register the
# mounted checkout here, preserving the image's selected torch/CUDA build.
uv pip install --python "${UV_PROJECT_ENVIRONMENT:-${VIRTUAL_ENV:-/opt/venv}}/bin/python" \
    --no-deps --no-build-isolation --editable "${1:-.}"
